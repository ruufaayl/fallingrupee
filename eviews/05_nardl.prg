' =====================================================================================
' THE PRICE OF A FALLING RUPEE — EViews program NARDL_MAIN
' Generated by scripts/06_write_eviews.py from the specification estimated in Python.
' Run 00_master.prg, or run this file after 01_import.prg has created the workfile.
' =====================================================================================

smpl 2015m01 2025m12
' ---- (1) Native EViews ARDL: automatic selection, AIC, max 4 lags, unrestricted constant (PSS case III)
'      Expected selected model: ARDL(1, 0, 1, 0, 2)
equation eq_nardl_main_native.ardl(deplags=4, reglags=4, ic=aic, trend=const) lfoodcpi lexr_pos lexr_neg lgfood ltranscpi @ seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11
freeze(tb_nardl_main_native) eq_nardl_main_native.output
'      Then open: View > Coefficient Diagnostics > Long Run Form and Bounds Test
'                 View > Coefficient Diagnostics > Error Correction Form (or ECM Regression)

' ---- (2) Explicit OLS replication on the common sample (first 4 observations reserved for lags)
smpl 2015m05 2025m12
equation eq_nardl_main_lev.ls lfoodcpi c lfoodcpi(-1) lexr_pos lexr_neg lexr_neg(-1) lgfood ltranscpi ltranscpi(-1) ltranscpi(-2) seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11
equation eq_nardl_main_cec.ls d(lfoodcpi) c lfoodcpi(-1) lexr_pos lexr_neg(-1) lgfood ltranscpi(-1) d(lexr_neg) d(ltranscpi) d(ltranscpi(-1)) seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11

' PSS bounds F-test (case III, k = 4): H0 all level coefficients = 0 -> compare F with I(0)/I(1) bounds
freeze(tb_nardl_main_bounds) eq_nardl_main_cec.wald c(2)=0, c(3)=0, c(4)=0, c(5)=0, c(6)=0
' PSS t-test = t-statistic on c(2) in eq_nardl_main_cec

' Long-run coefficients L = -theta/rho with delta-method standard errors
freeze(tb_nardl_main_lr_lexr_pos) eq_nardl_main_cec.wald -c(3)/c(2) = 0   ' long-run coefficient of lexr_pos
freeze(tb_nardl_main_lr_lexr_neg) eq_nardl_main_cec.wald -c(4)/c(2) = 0   ' long-run coefficient of lexr_neg
freeze(tb_nardl_main_lr_lgfood) eq_nardl_main_cec.wald -c(5)/c(2) = 0   ' long-run coefficient of lgfood
freeze(tb_nardl_main_lr_ltranscpi) eq_nardl_main_cec.wald -c(6)/c(2) = 0   ' long-run coefficient of ltranscpi

' Diagnostics on the levels ARDL
freeze(tb_nardl_main_bg2) eq_nardl_main_lev.auto(2)
freeze(tb_nardl_main_bg12) eq_nardl_main_lev.auto(12)
freeze(tb_nardl_main_bpg) eq_nardl_main_lev.hettest(type=bpg)
freeze(tb_nardl_main_white) eq_nardl_main_lev.hettest(type=white)
freeze(tb_nardl_main_arch1) eq_nardl_main_lev.hettest(type=arch, lags=1)
freeze(tb_nardl_main_arch12) eq_nardl_main_lev.hettest(type=arch, lags=12)
freeze(tb_nardl_main_reset) eq_nardl_main_lev.reset(1)
eq_nardl_main_lev.makeresids res_nardl_main
freeze(tb_nardl_main_jb) res_nardl_main.hist
freeze(gr_nardl_main_cusum) eq_nardl_main_lev.rls(q)
freeze(gr_nardl_main_cusumsq) eq_nardl_main_lev.rls(v)
gr_nardl_main_cusum.save(t=png) "{%out}nardl_main_cusum.png"
gr_nardl_main_cusumsq.save(t=png) "{%out}nardl_main_cusumsq.png"

table tb_eq_nardl_main_cec
tb_eq_nardl_main_cec(1,1) = "position"
tb_eq_nardl_main_cec(1,2) = "coef"
tb_eq_nardl_main_cec(1,3) = "se"
for !i = 1 to eq_nardl_main_cec.@ncoefs
  tb_eq_nardl_main_cec(!i+1,1) = @str(!i)
  tb_eq_nardl_main_cec(!i+1,2) = @str(eq_nardl_main_cec.@coefs(!i), "g15")
  tb_eq_nardl_main_cec(!i+1,3) = @str(eq_nardl_main_cec.@stderrs(!i), "g15")
next
tb_eq_nardl_main_cec.save(t=csv) "{%out}nardl_main_cec.csv"

table tb_eq_nardl_main_lev
tb_eq_nardl_main_lev(1,1) = "position"
tb_eq_nardl_main_lev(1,2) = "coef"
tb_eq_nardl_main_lev(1,3) = "se"
for !i = 1 to eq_nardl_main_lev.@ncoefs
  tb_eq_nardl_main_lev(!i+1,1) = @str(!i)
  tb_eq_nardl_main_lev(!i+1,2) = @str(eq_nardl_main_lev.@coefs(!i), "g15")
  tb_eq_nardl_main_lev(!i+1,3) = @str(eq_nardl_main_lev.@stderrs(!i), "g15")
next
tb_eq_nardl_main_lev.save(t=csv) "{%out}nardl_main_lev.csv"

' ---- NARDL asymmetry tests
' Long-run symmetry: H0 -c(3)/c(2) = -c(4)/c(2)  (LEXR_POS and LEXR_NEG are the 3rd and 4th CEC coefficients)
freeze(tb_nardl_lrsym) eq_nardl_main_cec.wald c(3)/c(2) = c(4)/c(2)
freeze(tb_nardl_lrsym_lin) eq_nardl_main_cec.wald c(3) = c(4)
' Impact (short-run) symmetry on the levels ARDL: beta+_0 = beta-_0
'   levels coefficients: c(1)=C, c(2)=LFOODCPI(-1), c(3)=LEXR_POS, c(4)=LEXR_NEG, c(5)=LEXR_NEG(-1), ...
freeze(tb_nardl_impact) eq_nardl_main_lev.wald c(3) = c(4)
' Dynamic multipliers are computed from the levels ARDL coefficients in scripts/ardl_engine.py
' (multipliers.json); in EViews they can be reproduced with the NARDL add-in if it is installed.

' =====================================================================================
' THE PRICE OF A FALLING RUPEE — EViews program ARDL_MAIN
' Generated by scripts/06_write_eviews.py from the specification estimated in Python.
' Run 00_master.prg, or run this file after 01_import.prg has created the workfile.
' =====================================================================================

smpl 2015m01 2025m12
' ---- (1) Native EViews ARDL: automatic selection, AIC, max 4 lags, unrestricted constant (PSS case III)
'      Expected selected model: ARDL(2, 1, 3, 2)
equation eq_ardl_main_native.ardl(deplags=4, reglags=4, ic=aic, trend=const) lfoodcpi lexr lgfood ltranscpi @ seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11
freeze(tb_ardl_main_native) eq_ardl_main_native.output
'      Then open: View > Coefficient Diagnostics > Long Run Form and Bounds Test
'                 View > Coefficient Diagnostics > Error Correction Form (or ECM Regression)

' ---- (2) Explicit OLS replication on the common sample (first 4 observations reserved for lags)
smpl 2015m05 2025m12
equation eq_ardl_main_lev.ls lfoodcpi c lfoodcpi(-1) lfoodcpi(-2) lexr lexr(-1) lgfood lgfood(-1) lgfood(-2) lgfood(-3) ltranscpi ltranscpi(-1) ltranscpi(-2) seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11
equation eq_ardl_main_cec.ls d(lfoodcpi) c lfoodcpi(-1) lexr(-1) lgfood(-1) ltranscpi(-1) d(lfoodcpi(-1)) d(lexr) d(lgfood) d(lgfood(-1)) d(lgfood(-2)) d(ltranscpi) d(ltranscpi(-1)) seas01 seas02 seas03 seas04 seas05 seas06 seas07 seas08 seas09 seas10 seas11

' PSS bounds F-test (case III, k = 3): H0 all level coefficients = 0 -> compare F with I(0)/I(1) bounds
freeze(tb_ardl_main_bounds) eq_ardl_main_cec.wald c(2)=0, c(3)=0, c(4)=0, c(5)=0
' PSS t-test = t-statistic on c(2) in eq_ardl_main_cec

' Long-run coefficients L = -theta/rho with delta-method standard errors
freeze(tb_ardl_main_lr_lexr) eq_ardl_main_cec.wald -c(3)/c(2) = 0   ' long-run coefficient of lexr
freeze(tb_ardl_main_lr_lgfood) eq_ardl_main_cec.wald -c(4)/c(2) = 0   ' long-run coefficient of lgfood
freeze(tb_ardl_main_lr_ltranscpi) eq_ardl_main_cec.wald -c(5)/c(2) = 0   ' long-run coefficient of ltranscpi

' Diagnostics on the levels ARDL
freeze(tb_ardl_main_bg2) eq_ardl_main_lev.auto(2)
freeze(tb_ardl_main_bg12) eq_ardl_main_lev.auto(12)
freeze(tb_ardl_main_bpg) eq_ardl_main_lev.hettest(type=bpg)
freeze(tb_ardl_main_white) eq_ardl_main_lev.hettest(type=white)
freeze(tb_ardl_main_arch1) eq_ardl_main_lev.hettest(type=arch, lags=1)
freeze(tb_ardl_main_arch12) eq_ardl_main_lev.hettest(type=arch, lags=12)
freeze(tb_ardl_main_reset) eq_ardl_main_lev.reset(1)
eq_ardl_main_lev.makeresids res_ardl_main
freeze(tb_ardl_main_jb) res_ardl_main.hist
freeze(gr_ardl_main_cusum) eq_ardl_main_lev.rls(q)
freeze(gr_ardl_main_cusumsq) eq_ardl_main_lev.rls(v)
gr_ardl_main_cusum.save(t=png) "{%out}ardl_main_cusum.png"
gr_ardl_main_cusumsq.save(t=png) "{%out}ardl_main_cusumsq.png"

table tb_eq_ardl_main_cec
tb_eq_ardl_main_cec(1,1) = "position"
tb_eq_ardl_main_cec(1,2) = "coef"
tb_eq_ardl_main_cec(1,3) = "se"
for !i = 1 to eq_ardl_main_cec.@ncoefs
  tb_eq_ardl_main_cec(!i+1,1) = @str(!i)
  tb_eq_ardl_main_cec(!i+1,2) = @str(eq_ardl_main_cec.@coefs(!i), "g15")
  tb_eq_ardl_main_cec(!i+1,3) = @str(eq_ardl_main_cec.@stderrs(!i), "g15")
next
tb_eq_ardl_main_cec.save(t=csv) "{%out}ardl_main_cec.csv"

table tb_eq_ardl_main_lev
tb_eq_ardl_main_lev(1,1) = "position"
tb_eq_ardl_main_lev(1,2) = "coef"
tb_eq_ardl_main_lev(1,3) = "se"
for !i = 1 to eq_ardl_main_lev.@ncoefs
  tb_eq_ardl_main_lev(!i+1,1) = @str(!i)
  tb_eq_ardl_main_lev(!i+1,2) = @str(eq_ardl_main_lev.@coefs(!i), "g15")
  tb_eq_ardl_main_lev(!i+1,3) = @str(eq_ardl_main_lev.@stderrs(!i), "g15")
next
tb_eq_ardl_main_lev.save(t=csv) "{%out}ardl_main_lev.csv"
